# Dinq — production environment
#
# Install to /etc/dinq/dinq.env, owned by root and readable only by root:
#   sudo mkdir -p /etc/dinq
#   sudo install -m 600 /dev/null /etc/dinq/dinq.env
#   sudo nano /etc/dinq/dinq.env
#
# systemd reads this file, so the syntax is KEY=value with no `export` and no
# quotes around the values. Every value here is read by
# backend/config/settings_prod.py, which refuses to start without them.
#
# SECRET_KEY signs sessions and CSRF tokens. Anyone holding it can forge a staff
# session. It is not in git and must never be shared.
#
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

DJANGO_SECRET_KEY=PASTE_THE_GENERATED_KEY_HERE

# Comma separated. The domain in both forms, plus the bare IP, because a
# certificate for the domain does not stop anyone typing the address. Anything
# missing from this list is answered with a 400 before the app is even reached.
DJANGO_ALLOWED_HOSTS=www.dinqadvisory.com,dinqadvisory.com,2.25.106.23

# Django's CSRF check compares scheme + host + port against this list, so the
# origin the browser actually sends has to appear here or form POSTs are rejected
# with 403 and the form silently fails.
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.dinqadvisory.com,https://dinqadvisory.com

# Leave false. Setting it true is a convenient way to read tracebacks on a
# public site, which also means printing environment and settings to whoever
# asks.
DJANGO_DEBUG=false

# nginx already redirects http to https, but this makes the guarantee hold for
# anything that reaches gunicorn directly.
DJANGO_SECURE_SSL_REDIRECT=true

# Start at 0. Turn this on only once certificate renewal is working and has been
# observed to succeed: a browser that has cached HSTS will refuse to fall back to
# plain http, so if the certificate later fails the site is unreachable until
# the header is removed from a browser's cache. 31536000 is one year.
DJANGO_HSTS_SECONDS=0

# INFO is normal. DEBUG is only for chasing a problem, and it logs every request.
DJANGO_LOG_LEVEL=INFO

# Email notifications for new public form submissions.
#
# Leave DJANGO_EMAIL_HOST blank to turn notifications off: submissions are still
# stored and appear in the staff panel, no mail is sent.
#
# These are SMTP relay credentials, not the recipient. A Gmail/Google Workspace
# account works with an App Password (Account -> Security -> 2-Step
# Verification -> App passwords); host smtp.gmail.com, port 587, TLS on.
# Transactional providers (Brevo, Mailgun, SendGrid, Resend SMTP) work the same
# way with their own host/user/password.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
# STARTTLS on 587. Use SSL (true) for port 465 instead; do not set both.
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false

# The From address on the alert. It must be an address the relay is allowed to
# send as, or the message is rejected or filed as spam.
DJANGO_DEFAULT_FROM_EMAIL=Dinq Advisory Group <no-reply@dinqadvisory.com>

# Who is told about a new /contact submission. Comma separated for more than one.
DJANGO_CONTACT_NOTIFICATION_EMAILS=eyosialex12@gmail.com

# The SQLite database. Only change this to point at a different file; changing
# the engine to PostgreSQL is a code change in settings_prod.py, not a value here.
DJANGO_DB_PATH=/srv/dinq/backend/db.sqlite3
