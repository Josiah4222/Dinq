# Python
__pycache__/
*.py[cod]
.venv/
venv/

# SQLite - the local development database
*.sqlite3

# Uploaded images
#
# MEDIA_ROOT. These are content, not code: they are created by staff through the
# CMS and must survive a redeploy, so they are deliberately never committed. Back
# this directory up separately - losing it loses every uploaded image.
backend/media/

# STATIC_ROOT, the output of `manage.py collectstatic`. Same reasoning as
# backend/media: regenerated by the deploy on every run, and it can hold
# thousands of copied files, so committing it would bloat the repo and add
# nothing. backend/static/ is the source and IS committed.
backend/staticfiles/

# Angular
node_modules/
frontend/dist/
.angular/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
